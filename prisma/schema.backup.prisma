// =====================================================
// Animal Marketplace — Prisma Schema
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum user_role {
  BUYER
  SELLER
  ADMIN
}

enum listing_status {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SOLD
  ARCHIVED
}

enum seller_verification_status {
  PENDING
  APPROVED
  REJECTED
}

enum transaction_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum report_status {
  OPEN
  RESOLVED
  DISMISSED
}

// =====================================================
// USERS
// =====================================================

model users {
  id            String    @id @default(uuid()) @db.Uuid
  full_name     String?   @db.VarChar(120)
  name          String?   @db.VarChar(120)
  email         String    @unique @db.VarChar(150)
  phone         String?   @unique @db.VarChar(20)
  role          user_role @default(BUYER)
  is_verified   Boolean   @default(false)
  password_hash String?   @db.VarChar(255)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Relations
  listings                listings[]
  favorites               favorites[]
  messages                messages[]
  conversations_as_buyer  conversations[] @relation("conversations_buyer")
  conversations_as_seller conversations[] @relation("conversations_seller")

  transactions_as_buyer  transactions[] @relation("transactions_buyer")
  transactions_as_seller transactions[] @relation("transactions_seller")

  seller_profile seller_profiles?

  reviews_written  reviews[] @relation("reviews_reviewer")
  reviews_received reviews[] @relation("reviews_reviewee")

  reports_filed    reports[] @relation("reports_reporter")
  reports_received reports[] @relation("reports_reported_user")
  reports_resolved reports[] @relation("reports_resolved_by")

  notifications notifications[]
  audit_logs    audit_logs[]

  @@map("users")
}

// =====================================================
// SELLER PROFILES
// =====================================================

model seller_profiles {
  id                  String                     @id @default(uuid()) @db.Uuid
  user_id             String                     @unique @db.Uuid
  display_name        String?                    @db.VarChar(150)
  bio                 String?                    @db.Text
  city                String?                    @db.VarChar(100)
  district            String?                    @db.VarChar(100)
  verification_status seller_verification_status @default(PENDING)
  approved_at         DateTime?                  @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user users @relation(
    fields: [user_id],
    references: [id],
  )

  @@map("seller_profiles")
}

// =====================================================
// ANIMAL CATEGORIES
// =====================================================

model animal_categories {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(100)
  slug       String   @unique @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  breeds   animal_breeds[]
  listings listings[]

  @@index([is_active])
  @@map("animal_categories")
}

// =====================================================
// ANIMAL BREEDS
// =====================================================

model animal_breeds {
  id          String   @id @default(uuid()) @db.Uuid
  category_id String   @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @db.VarChar(120)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  category animal_categories @relation(
    fields: [category_id],
    references: [id],
  )

  listings listings[]

  @@unique([category_id, name])
  @@unique([category_id, slug])
  @@index([category_id])
  @@index([is_active])
  @@map("animal_breeds")
}

// =====================================================
// LISTINGS
// =====================================================

model listings {
  id          String  @id @default(uuid()) @db.Uuid
  seller_id   String  @db.Uuid
  category_id String? @db.Uuid
  breed_id    String? @db.Uuid

  title       String   @db.VarChar(200)
  description String?  @db.Text
  price       Decimal? @db.Decimal(12, 2)
  negotiable  Boolean  @default(true)

  gender String?  @db.VarChar(20)
  age    String?  @db.VarChar(50)
  weight Decimal? @db.Decimal(8, 2)
  colour String?  @db.VarChar(50)

  city     String? @db.VarChar(100)
  area     String? @db.VarChar(150)
  district String? @db.VarChar(100)
  state    String? @db.VarChar(100)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  status listing_status @default(PENDING_REVIEW)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // Seller
  seller users @relation(
    fields: [seller_id],
    references: [id],
  )

  // Category
  category animal_categories? @relation(
    fields: [category_id],
    references: [id],
  )

  // Breed
  breed animal_breeds? @relation(
    fields: [breed_id],
    references: [id],
  )

  // Other relations
  favorites     favorites[]
  images        listing_images[]
  conversations conversations[]
  transactions  transactions[]
  reports       reports[]

  @@index([seller_id])
  @@index([category_id])
  @@index([breed_id])
  @@index([status])
  @@index([city])
  @@map("listings")
}

// =====================================================
// LISTING IMAGES
// =====================================================

model listing_images {
  id         String   @id @default(uuid()) @db.Uuid
  listing_id String   @db.Uuid
  media_url  String   @db.Text
  type       String?  @default("image") @db.VarChar(20)
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  listing listings @relation(
    fields: [listing_id],
    references: [id],
  )

  @@index([listing_id])
  @@map("listing_images")
}

// =====================================================
// FAVORITES
// =====================================================

model favorites {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  listing_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(
    fields: [user_id],
    references: [id],
  )

  listing listings @relation(
    fields: [listing_id],
    references: [id],
  )

  @@unique([user_id, listing_id])
  @@index([user_id])
  @@index([listing_id])
  @@map("favorites")
}

// =====================================================
// CONVERSATIONS
// =====================================================

model conversations {
  id         String  @id @default(uuid()) @db.Uuid
  buyer_id   String  @db.Uuid
  seller_id  String  @db.Uuid
  listing_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  buyer users @relation(
    "conversations_buyer",
    fields: [buyer_id],
    references: [id],
  )

  seller users @relation(
    "conversations_seller",
    fields: [seller_id],
    references: [id],
  )

  listing listings? @relation(
    fields: [listing_id],
    references: [id],
  )

  messages messages[]

  @@index([buyer_id])
  @@index([seller_id])
  @@index([listing_id])
  @@map("conversations")
}

// =====================================================
// MESSAGES
// =====================================================

model messages {
  id              String   @id @default(uuid()) @db.Uuid
  conversation_id String   @db.Uuid
  sender_id       String   @db.Uuid
  message         String   @db.Text
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  conversation conversations @relation(
    fields: [conversation_id],
    references: [id],
  )

  sender users @relation(
    fields: [sender_id],
    references: [id],
  )

  @@index([conversation_id])
  @@index([sender_id])
  @@map("messages")
}

// =====================================================
// TRANSACTIONS
// =====================================================

model transactions {
  id           String             @id @default(uuid()) @db.Uuid
  listing_id   String             @db.Uuid
  buyer_id     String             @db.Uuid
  seller_id    String             @db.Uuid
  animal_price Decimal            @db.Decimal(12, 2)
  platform_fee Decimal?           @db.Decimal(12, 2)
  total_amount Decimal?           @db.Decimal(12, 2)
  status       transaction_status @default(PENDING)
  payment_id   String?            @db.VarChar(150)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  buyer users @relation(
    "transactions_buyer",
    fields: [buyer_id],
    references: [id],
  )

  seller users @relation(
    "transactions_seller",
    fields: [seller_id],
    references: [id],
  )

  listing listings @relation(
    fields: [listing_id],
    references: [id],
  )

  reviews reviews[]

  @@index([buyer_id])
  @@index([seller_id])
  @@index([listing_id])
  @@map("transactions")
}

// =====================================================
// REVIEWS
// =====================================================

model reviews {
  id             String   @id @default(uuid()) @db.Uuid
  transaction_id String   @db.Uuid
  reviewer_id    String   @db.Uuid
  reviewee_id    String   @db.Uuid
  rating         Int
  comment        String?  @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  transaction transactions @relation(
    fields: [transaction_id],
    references: [id],
  )

  reviewer users @relation(
    "reviews_reviewer",
    fields: [reviewer_id],
    references: [id],
  )

  reviewee users @relation(
    "reviews_reviewee",
    fields: [reviewee_id],
    references: [id],
  )

  @@index([transaction_id])
  @@index([reviewer_id])
  @@index([reviewee_id])
  @@map("reviews")
}

// =====================================================
// REPORTS
// =====================================================

model reports {
  id               String        @id @default(uuid()) @db.Uuid
  reporter_id      String        @db.Uuid
  reported_user_id String?       @db.Uuid
  listing_id       String?       @db.Uuid
  reason           String?       @db.Text
  status           report_status @default(OPEN)
  resolved_by      String?       @db.Uuid
  resolved_at      DateTime?     @db.Timestamptz(6)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)

  reporter users @relation(
    "reports_reporter",
    fields: [reporter_id],
    references: [id],
  )

  reported_user users? @relation(
    "reports_reported_user",
    fields: [reported_user_id],
    references: [id],
  )

  resolved_user users? @relation(
    "reports_resolved_by",
    fields: [resolved_by],
    references: [id],
  )

  listing listings? @relation(
    fields: [listing_id],
    references: [id],
  )

  @@index([reporter_id])
  @@index([reported_user_id])
  @@index([listing_id])
  @@map("reports")
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model notifications {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  title      String?  @db.VarChar(200)
  message    String?  @db.Text
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(
    fields: [user_id],
    references: [id],
  )

  @@index([user_id])
  @@map("notifications")
}

// =====================================================
// AUDIT LOGS
// =====================================================

model audit_logs {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  action     String?  @db.VarChar(100)
  details    String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users? @relation(
    fields: [user_id],
    references: [id],
  )

  @@index([user_id])
  @@map("audit_logs")
}
