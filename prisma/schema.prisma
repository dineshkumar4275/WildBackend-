generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                   Int                  @id @default(autoincrement())
  name                 String               @db.VarChar(100)
  email                String               @unique @db.VarChar(100)
  password             String?              @db.VarChar(255)
  role                 String?              @default("user") @db.VarChar(20)
  is_active            Boolean?             @default(true)
  last_login           DateTime?            @db.Timestamp(6)
  created_at           DateTime?            @default(now()) @db.Timestamp(6)
  updated_at           DateTime?            @default(now()) @updatedAt @db.Timestamp(6)
  phone                String?              @db.VarChar(20)
  preferred_language   String?              @default("en") @db.VarChar(10)
  full_name            String?              @db.VarChar(100)
  mobile               String?              @db.VarChar(15)
  alternate_mobile     String?              @db.VarChar(15)
  address_line1        String?
  address_line2        String?
  landmark             String?              @db.VarChar(100)
  city                 String?              @db.VarChar(50)
  district             String?              @db.VarChar(50)
  state                String?              @db.VarChar(50)
  country              String?              @default("India") @db.VarChar(50)
  pincode              String?              @db.VarChar(10)
  latitude             Decimal?             @db.Decimal(10, 8)
  longitude            Decimal?             @db.Decimal(11, 8)
  address_type         String?              @default("Home") @db.VarChar(20)
  address_updated_at   DateTime?            @default(now()) @db.Timestamp(6)
  is_admin             Boolean?             @default(false)
  login_attempts       Int?                 @default(0)
  locked_until         DateTime?            @db.Timestamp(6)
  two_factor_enabled   Boolean?             @default(false)
  two_factor_secret    String?              @db.VarChar(255)
  admin_activity_log   admin_activity_log[]
  admin_sessions       admin_sessions[]
  audit_logs           audit_logs[]
  buyer_conversations  conversations[]      @relation("conversation_buyer")
  seller_conversations conversations[]      @relation("conversation_seller")
  favorites            favorites[]
  listing              listing[]
  listings             listings[]
  messages             messages[]
  notifications        notifications[]
  reports_received     reports[]            @relation("reported_user")
  reports_given        reports[]            @relation("reporter")
  reports_resolved     reports[]            @relation("resolved_by")
  reviews_received     reviews[]            @relation("reviewee")
  reviews_given        reviews[]            @relation("reviewer")
  seller_profiles      seller_profiles?
  buyer_transactions   transactions[]       @relation("transaction_buyer")
  seller_transactions  transactions[]       @relation("transaction_seller")
  two_factor_codes     two_factor_codes[]
  unlock               unlock[]
  wishlists            wishlists[]

  @@index([city], map: "idx_users_city")
  @@index([pincode], map: "idx_users_pincode")
  @@index([state], map: "idx_users_state")
  @@map("users")
}

model seller_profiles {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             Int                        @unique
  display_name        String?                    @db.VarChar(150)
  bio                 String?
  city                String?                    @db.VarChar(100)
  district            String?                    @db.VarChar(100)
  verification_status seller_verification_status @default(PENDING)
  approved_at         DateTime?                  @db.Timestamptz(6)
  created_at          DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  user                users                      @relation(fields: [user_id], references: [id])
}

model animal_categories {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String          @unique @db.VarChar(100)
  slug       String          @unique @db.VarChar(100)
  is_active  Boolean         @default(true)
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  breeds     animal_breeds[]
  listings   listings[]

  @@index([is_active])
}

model animal_breeds {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id String            @db.Uuid
  name        String            @db.VarChar(120)
  slug        String            @db.VarChar(120)
  is_active   Boolean           @default(true)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  category    animal_categories @relation(fields: [category_id], references: [id])
  listings    listings[]

  @@unique([category_id, name])
  @@unique([category_id, slug])
  @@index([category_id])
  @@index([is_active])
}

model listings {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id     Int
  category_id   String?            @db.Uuid
  breed_id      String?            @db.Uuid
  title         String             @db.VarChar(200)
  description   String?
  price         Decimal?           @db.Decimal(12, 2)
  negotiable    Boolean            @default(true)
  gender        String?            @db.VarChar(20)
  age           String?            @db.VarChar(50)
  weight        Decimal?           @db.Decimal(8, 2)
  colour        String?            @db.VarChar(50)
  city          String?            @db.VarChar(100)
  area          String?            @db.VarChar(150)
  district      String?            @db.VarChar(100)
  state         String?            @db.VarChar(100)
  latitude      Decimal?           @db.Decimal(10, 7)
  longitude     Decimal?           @db.Decimal(10, 7)
  status        listing_status     @default(PENDING_REVIEW)
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  conversations conversations[]
  favorites     favorites[]
  images        listing_images[]
  breed         animal_breeds?     @relation(fields: [breed_id], references: [id])
  category      animal_categories? @relation(fields: [category_id], references: [id])
  seller        users              @relation(fields: [seller_id], references: [id])
  reports       reports[]
  transactions  transactions[]

  @@index([seller_id])
  @@index([category_id])
  @@index([breed_id])
  @@index([status])
  @@index([city])
}

model listing_images {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id           String   @db.Uuid
  media_url            String
  cloudinary_public_id String?
  type                 String   @default("image") @db.VarChar(20)
  is_primary           Boolean  @default(false)
  sort_order           Int      @default(0)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  listing              listings @relation(fields: [listing_id], references: [id])

  @@index([listing_id])
}

model favorites {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int
  listing_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  listing    listings @relation(fields: [listing_id], references: [id])
  user       users    @relation(fields: [user_id], references: [id])

  @@unique([user_id, listing_id])
  @@index([user_id])
  @@index([listing_id])
}

model conversations {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_id   Int
  seller_id  Int
  listing_id String?    @db.Uuid
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  buyer      users      @relation("conversation_buyer", fields: [buyer_id], references: [id])
  listing    listings?  @relation(fields: [listing_id], references: [id])
  seller     users      @relation("conversation_seller", fields: [seller_id], references: [id])
  messages   messages[]

  @@index([buyer_id])
  @@index([seller_id])
  @@index([listing_id])
}

model messages {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_id       Int
  message         String
  is_read         Boolean       @default(false)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  conversation    conversations @relation(fields: [conversation_id], references: [id])
  sender          users         @relation(fields: [sender_id], references: [id])

  @@index([conversation_id])
  @@index([sender_id])
}

model transactions {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id   String             @db.Uuid
  buyer_id     Int
  seller_id    Int
  animal_price Decimal            @db.Decimal(12, 2)
  platform_fee Decimal?           @db.Decimal(12, 2)
  total_amount Decimal?           @db.Decimal(12, 2)
  status       transaction_status @default(PENDING)
  payment_id   String?            @db.VarChar(150)
  created_at   DateTime           @default(now()) @db.Timestamptz(6)
  updated_at   DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  reviews      reviews[]
  buyer        users              @relation("transaction_buyer", fields: [buyer_id], references: [id])
  listing      listings           @relation(fields: [listing_id], references: [id])
  seller       users              @relation("transaction_seller", fields: [seller_id], references: [id])

  @@index([buyer_id])
  @@index([seller_id])
  @@index([listing_id])
  @@index([status])
}

model reviews {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id String       @db.Uuid
  reviewer_id    Int
  reviewee_id    Int
  rating         Int
  comment        String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  reviewee       users        @relation("reviewee", fields: [reviewee_id], references: [id])
  reviewer       users        @relation("reviewer", fields: [reviewer_id], references: [id])
  transaction    transactions @relation(fields: [transaction_id], references: [id])

  @@unique([transaction_id, reviewer_id])
  @@index([transaction_id])
  @@index([reviewer_id])
  @@index([reviewee_id])
}

model reports {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporter_id      Int
  reported_user_id Int?
  listing_id       String?       @db.Uuid
  reason           String?
  status           report_status @default(OPEN)
  resolved_by      Int?
  resolved_at      DateTime?     @db.Timestamptz(6)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  listing          listings?     @relation(fields: [listing_id], references: [id])
  reported_user    users?        @relation("reported_user", fields: [reported_user_id], references: [id])
  reporter         users         @relation("reporter", fields: [reporter_id], references: [id])
  resolved_user    users?        @relation("resolved_by", fields: [resolved_by], references: [id])

  @@index([reporter_id])
  @@index([reported_user_id])
  @@index([listing_id])
  @@index([status])
}

model notifications {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int
  title      String?  @db.VarChar(200)
  message    String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([is_read])
}

model audit_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int?
  action     String?  @db.VarChar(100)
  details    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users?   @relation(fields: [user_id], references: [id])

  @@index([user_id])
}

model admin_activity_log {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  action     String    @db.VarChar(100)
  ip_address String?   @db.VarChar(45)
  user_agent String?
  details    Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_admin_activity_log_user_id")
}

model admin_sessions {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  session_token String    @unique @db.VarChar(255)
  ip_address    String?   @db.VarChar(45)
  user_agent    String?
  is_valid      Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  expires_at    DateTime  @db.Timestamp(6)
  users         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_token], map: "idx_admin_sessions_token")
  @@index([user_id], map: "idx_admin_sessions_user_id")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model driver_earnings {
  id         Int
  driver_id  Int?
  order_id   Int?
  amount     Decimal   @db.Decimal(10, 2)
  commission Decimal?  @db.Decimal(10, 2)
  status     String?   @default("pending") @db.VarChar(50)
  paid_at    DateTime? @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model driver_location_history {
  id         Int
  driver_id  Int?
  latitude   Decimal?  @db.Decimal(10, 8)
  longitude  Decimal?  @db.Decimal(11, 8)
  address    String?
  street     String?   @db.VarChar(255)
  city       String?   @db.VarChar(100)
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@ignore
}

model driver_notifications {
  id         Int       @id @default(autoincrement())
  driver_id  Int
  title      String    @db.VarChar(255)
  message    String?
  type       String?   @default("general") @db.VarChar(50)
  is_read    Boolean?  @default(false)
  data       Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([created_at(sort: Desc)], map: "idx_driver_notifications_created_at")
  @@index([driver_id], map: "idx_driver_notifications_driver_id")
}

model drivers {
  id                   Int       @id @default(autoincrement())
  name                 String    @db.VarChar(100)
  email                String?   @db.VarChar(100)
  phone                String    @db.VarChar(15)
  password             String?   @db.VarChar(255)
  vehicle_number       String?   @db.VarChar(50)
  vehicle_type         String?   @db.VarChar(50)
  is_available         Boolean?  @default(true)
  current_latitude     Decimal?  @db.Decimal(10, 8)
  current_longitude    Decimal?  @db.Decimal(11, 8)
  last_location_update DateTime? @db.Timestamp(6)
  fcm_token            String?
  created_at           DateTime? @default(now()) @db.Timestamp(6)
  is_active            Boolean?  @default(true)
  total_deliveries     Int?      @default(0)
  rating               Decimal?  @default(5.0) @db.Decimal(2, 1)
  updated_at           DateTime? @default(now()) @db.Timestamp(6)
  current_address      String?
  current_city         String?   @db.VarChar(100)
  current_street       String?   @db.VarChar(255)
  push_token           String?   @db.VarChar(255)
  is_on_break          Boolean?  @default(false)
  break_started_at     DateTime? @db.Timestamp(6)
  total_rating         Decimal?  @default(5.0) @db.Decimal
  total_ratings_count  Int?      @default(0)
}

model listing {
  id            Int      @id @default(autoincrement())
  sellerId      Int
  title         String   @db.VarChar(200)
  category      String   @db.VarChar(50)
  breed         String   @db.VarChar(100)
  price         Decimal  @db.Decimal(10, 2)
  age           String?  @db.VarChar(50)
  description   String
  location      String   @db.VarChar(255)
  images        String[]
  status        String   @default("PENDING") @db.VarChar(20)
  rejectionNote String?
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @db.Timestamp(6)
  users         users    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  unlock        unlock[]

  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([sellerId])
  @@index([status])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model orders {
  id                      Int       @default(autoincrement())
  user_id                 Int?
  order_number            String    @db.VarChar(50)
  total_amount            Decimal   @db.Decimal(10, 2)
  status                  String?   @default("pending") @db.VarChar(20)
  payment_status          String?   @default("pending") @db.VarChar(20)
  payment_id              String?   @db.VarChar(100)
  razorpay_order_id       String?   @db.VarChar(100)
  shipping_address        String?
  products                Json?
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
  delivery_latitude       Decimal?  @db.Decimal(10, 8)
  delivery_longitude      Decimal?  @db.Decimal(11, 8)
  driver_id               Int?
  estimated_delivery      DateTime? @db.Timestamp(6)
  payment_method          String?   @default("cod") @db.VarChar(50)
  driver_name             String?   @db.VarChar(100)
  customer_name           String?   @db.VarChar(255)
  customer_email          String?   @db.VarChar(255)
  customer_phone          String?   @db.VarChar(20)
  delivery_fee            Decimal?  @default(0) @db.Decimal(10, 2)
  shipping_full_name      String?   @db.VarChar(100)
  shipping_mobile         String?   @db.VarChar(15)
  shipping_address_line1  String?
  shipping_address_line2  String?
  shipping_landmark       String?   @db.VarChar(100)
  shipping_city           String?   @db.VarChar(50)
  shipping_state          String?   @db.VarChar(50)
  shipping_country        String?   @db.VarChar(50)
  shipping_pincode        String?   @db.VarChar(10)
  proof_photo_url         String?
  delivery_notes          String?
  reject_reason           String?
  rejected_at             DateTime? @db.Timestamp(6)
  cod_amount              Decimal?  @default(0) @db.Decimal
  cod_collected           Boolean?  @default(false)
  customer_rating         Int?
  customer_rating_comment String?
  rated_at                DateTime? @db.Timestamp(6)
  delivery_otp            String?

  @@ignore
}

model otps {
  id         Int       @id @default(autoincrement())
  contact    String    @db.VarChar(255)
  type       String?   @default("email") @db.VarChar(20)
  otp        String    @db.VarChar(6)
  purpose    String?   @default("login") @db.VarChar(20)
  is_admin   Boolean?  @default(false)
  expires_at DateTime  @db.Timestamp(6)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model products {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(200)
  description      String?
  price            Decimal   @db.Decimal(10, 2)
  compare_at_price Decimal?  @db.Decimal(10, 2)
  category         String?   @db.VarChar(100)
  sub_category     String?   @db.VarChar(100)
  brand            String?   @db.VarChar(100)
  stock            Int?      @default(0)
  sku              String?   @unique @db.VarChar(50)
  image_url        String?
  images           String[]
  rating           Decimal?  @default(0) @db.Decimal(3, 2)
  num_reviews      Int?      @default(0)
  is_featured      Boolean?  @default(false)
  is_active        Boolean?  @default(true)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  deleted_at       DateTime? @db.Timestamp(6)
  image_url_2      String?
  image_url_3      String?
  compare_price    Decimal?  @db.Decimal(10, 2)
  model            String?   @db.VarChar(100)
  warranty         String?   @db.VarChar(100)
  weight           String?   @db.VarChar(50)
  dimensions       String?   @db.VarChar(100)
  material         String?   @db.VarChar(100)
  features         String?
  review_count     Int?      @default(0)
  tags             String?
  meta_title       String?   @db.VarChar(255)
  meta_description String?
  seo_keywords     String?
  image_url_4      String?
  image_url_5      String?
  has_colors       Boolean?  @default(false)
  colors           Json?     @default("[]")
  has_sizes        Boolean?  @default(false)
  sizes            Json?     @default("[]")
  name_ta          String?
  description_ta   String?
  name_hi          String?
  description_hi   String?
}

model two_factor_codes {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  code       String    @db.VarChar(6)
  purpose    String?   @default("admin_login") @db.VarChar(20)
  expires_at DateTime  @db.Timestamp(6)
  used       Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_two_factor_codes_user_id")
}

model unlock {
  id        Int      @id @default(autoincrement())
  buyerId   Int
  listingId Int
  createdAt DateTime @default(now()) @db.Timestamp(6)
  users     users    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listing   listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([buyerId, listingId], map: "buyerId_listingId")
  @@index([buyerId])
  @@index([listingId])
}

model wishlists {
  id            Int       @id @default(autoincrement())
  user_id       Int?
  product_id    Int
  product_name  String?   @db.VarChar(255)
  product_price Decimal?  @db.Decimal(10, 2)
  product_image String?
  added_at      DateTime? @default(now()) @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id])
  @@index([product_id], map: "idx_wishlists_product_id")
  @@index([user_id], map: "idx_wishlists_user_id")
}

enum listing_status {
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SOLD
  ARCHIVED
}

enum seller_verification_status {
  PENDING
  APPROVED
  REJECTED
}

enum transaction_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum report_status {
  OPEN
  RESOLVED
  DISMISSED
}
